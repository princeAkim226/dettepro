# Obligatoire — refus de démarrer si manquant
DATABASE_URL="postgresql://dettepro:CHANGE_ME@127.0.0.1:5432/dettepro?schema=public"
AUTH_SECRET="générer-avec-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin seed (optionnel au premier démarrage)
ADMIN_PHONE="70000000"
ADMIN_PASSWORD="change-me-admin"
ADMIN_NAME="Admin DettePro"

# Paiement manuel — numéros affichés aux boutiquiers
PAYMENT_ORANGE_MONEY="70 XX XX XX"
PAYMENT_WAVE="70 XX XX XX"
PAYMENT_MOOV="70 XX XX XX"

# WhatsApp Cloud API (ou dry-run)
WHATSAPP_DRY_RUN="true"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
# Notif one-way (template UTILITY Meta — pas de conversation)
WHATSAPP_TEMPLATE_NAME="dettepro_rappel"
WHATSAPP_TEMPLATE_LANG="fr"

# TTS — voix neural FR (Microsoft Edge, sans clé API)
TTS_ENABLED="true"
