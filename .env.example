NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin seed (optionnel au premier démarrage)
ADMIN_PHONE="70000000"
ADMIN_PASSWORD="change-me-admin"
ADMIN_NAME="Admin DettePro"

# Paiement — lien SasPay (principal) + numéros manuels (secours)
