# Secret affiché UNE fois dans SasPay → Webhooks (copier dans Coolify)
SASPAY_WEBHOOK_SECRET=""
# Optionnel — clé API sk_live_… / sk_test_…
SASPAY_API_KEY=""
PAYMENT_ORANGE_MONEY="70 XX XX XX"
PAYMENT_WAVE="70 XX XX XX"
PAYMENT_MOOV="70 XX XX XX"

# WhatsApp Cloud API (ou dry-run)
WHATSAPP_DRY_RUN="true"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
# Notif one-way (template UTILITY Meta — pas de conversation)
WHATSAPP_TEMPLATE_NAME="dettepro_rappel"
WHATSAPP_TEMPLATE_LANG="fr"
WHATSAPP_VERIFY_TOKEN="générer-une-chaine-secrete"

# TTS — voix neural FR (Microsoft Edge, sans clé API)
TTS_ENABLED="true"
